<div class="toast" id="toast"></div>


<script>

let running = false;

const $ = id => document.getElementById(id);


function toast(message){

  $("toast").textContent = message;

  $("toast").style.display = "block";

  setTimeout(() => {
    $("toast").style.display = "none";
  },2200);

}


function log(message){

  const box = $("telemetry");

  box.innerHTML +=
    `<br>[${new Date().toLocaleTimeString()}] ${message}`;

  box.scrollTop = box.scrollHeight;

}


function runAnalysis(){

  if(running) return;

  running = true;

  const steps = [

    "Initializing quantum core...",

    "Receiving satellite data...",

    "Scanning emergency requests...",

    "Calculating candidate routes...",

    "Optimizing safe route...",

    "Preparing dispatch packet..."

  ];

  let i = 0;


  const timer = setInterval(() => {

    log(steps[i]);

    $("convbar").style.width =
      ((i + 1) / steps.length * 100) + "%";


    if(i === steps.length - 1){

      clearInterval(timer);

      running = false;


      $("conv").textContent =
        (1.2 + Math.random() * .5).toFixed(1) + "s";


      $("safe").textContent =
        (97.5 + Math.random() * 1.2).toFixed(1) + "%";


      $("copilot").textContent =
        "Optimal ridge bypass identified. Dispatch can proceed in demo mode.";


      log(
        "Route locked: Ridge Bypass. Hazard intersections minimized."
      );


      toast(
        "Quantum analysis simulation complete"
      );

    }

    i++;

  },420);

}


function updateRain(){

  const r = +$("rain").value;

  $("rainValue").textContent =
    r + " mm/h";


  const surge =
    (.8 + r / 75).toFixed(1);


  $("surge").textContent =
    "+" + surge + "m";


  const risk =
    $("riskText");


  if(r < 60){

    risk.textContent =
      "MODERATE RISK";

    risk.className =
      "orange";

  }

  else if(r < 120){

    risk.textContent =
      "HIGH RISK";

    risk.className =
      "red";

  }

  else{

    risk.textContent =
      "EXTREME RISK";

    risk.className =
      "red";

  }


  const km =
    (2.2 + r / 190).toFixed(1);


  $("safeRoute").textContent =
    km + " km";

  $("route").textContent =
    km + " km";


  log(
    `Rainfall scenario updated to ${r} mm/h; surge estimate +${surge}m.`
  );

}


function reroute(){

  const km =
    (2.4 + Math.random() * 1.1).toFixed(1);

  const eta =
    Math.max(3,Math.round(7 - km));


  $("route").textContent =
    km + " km";

  $("safeRoute").textContent =
    km + " km";

  $("eta").textContent =
    eta + " min";


  log(
    `Dynamic reroute calculated: ${km} km, ETA ${eta} min.`
  );


  toast(
    "Safe route recalculated"
  );

}


function simulateAlert(){

  const alerts = [

    [
      "📡",
      "SOS beacon cluster detected",
      "12 distress beacons correlated in Sector 4."
    ],

    [
      "🌧️",
      "Rainfall surge detected",
      "Hazard model recommends immediate route review."
    ],

    [
      "🚑",
      "Medical priority request",
      "Critical supply delivery requested at Safe Haven 3."
    ]

  ];


  const a =
    alerts[Math.floor(Math.random() * alerts.length)];


  const element =
    document.createElement("div");


  element.className =
    "alert";


  element.innerHTML = `

    <div>
      ${a[0]}
    </div>

    <div>

      <b>
        ${a[1]}
      </b>

      <br>

      <small>
        ${a[2]}
      </small>

    </div>

    <small>
      now
    </small>

  `;


  $("alerts").prepend(element);


  log(
    "ALERT: " + a[1]
  );


  toast(
    "New emergency alert added"
  );

}

</script>

